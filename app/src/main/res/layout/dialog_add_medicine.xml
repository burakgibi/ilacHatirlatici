<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/blue">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yeni İlaç Ekle"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="İlaç Adı (Örn: Parol)"
        android:textColorHint="@color/white"
        android:inputType="textCapWords"
        android:layout_marginBottom="8dp"
        android:padding="20px"/>

    <EditText
        android:id="@+id/etDosage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Dozaj Ve Açıklama (Örn: 1 Tablet - Tok)"
        android:textColorHint="@color/white"
        android:inputType="text"
        android:layout_marginBottom="8dp"
        android:padding="20px" />

    <EditText
        android:id="@+id/etInterval"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Kaç saatte bir? (1 Günde 1 İçin 24 Giriniz)"
        android:inputType="number"
        android:layout_marginBottom="16dp"
        android:textColorHint="@color/white"/>

    <Switch
        android:id="@+id/switchSound"
        android:layout_width="wrap_content"
        android:layout_height="23dp"
        android:layout_marginBottom="12dp"
        android:checked="true"
        android:text="Sesli Alarm"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="italic"
        android:layout_marginLeft="3dp"/>

    <Button
        android:id="@+id/btnSelectTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/skyBlue"
        android:text="Saat Seç"
        android:textColor="@color/white"
        android:textSize="17sp"
        android:textStyle="bold"/>

</LinearLayout>